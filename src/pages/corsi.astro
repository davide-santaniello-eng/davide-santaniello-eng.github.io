    const SUPABASE_URL = 'https://cdcfcichrheumgfibgur.supabase.co';
    const SUPABASE_KEY = 'sb_publishable_8GZ9RM14uxyfkSW-2cI64w_AbwmqE06';
    let supabaseClient = null;

    function getSupabaseClient() {
      if (supabaseClient) return supabaseClient;
      if (window.supabase && typeof window.supabase.createClient === 'function') {
        supabaseClient = window.supabase.createClient(SUPABASE_URL, SUPABASE_KEY);
      }
      return supabaseClient;
    }

    function setCloudStatus(status, text) {
      const dot = document.getElementById('cloudStatusDot');
      const label = document.getElementById('cloudStatusText');
      if (!dot || !label) return;

      dot.className = 'status-dot';
      if (status === 'syncing') {
        dot.classList.add('syncing');
        label.textContent = text || 'Salvataggio cloud...';
      } else if (status === 'synced') {
        dot.classList.add('synced');
        label.textContent = text || 'Cloud sincronizzato';
      } else if (status === 'error') {
        dot.classList.add('error');
        label.textContent = text || 'Offline / Errore sync';
      } else {
        label.textContent = text || 'Pronto';
      }
    }

    const DEFAULT_PRELOADS = {
      'SM': {
        completed: ["lesson_13", "lesson_14", "lesson_15", "lesson_16", "lesson_17", "lesson_18"],
        targetDate: "2026-11-16"
      }
    };

    let currentCourseId = localStorage.getItem('polimi_selected_course_v1') || 'SM';
    let currentFilter = 'all';
    let saveTimeout = null;

    function getStorageKey() {
      return `course_progress_${currentCourseId}_v1`;
    }

    function getTargetDateKey() {
      return `course_target_date_${currentCourseId}_v1`;
    }

    function getCompletedSet() {
      return new Set(JSON.parse(localStorage.getItem(getStorageKey()) || '[]'));
    }

    async function syncFromCloud(courseId, retryCount = 0) {
      const sb = getSupabaseClient();
      if (!sb) {
        if (retryCount < 4) {
          setTimeout(() => syncFromCloud(courseId, retryCount + 1), 400);
          return;
        }
        setCloudStatus('error', 'Offline / CDN in attesa');
        return;
      }
      setCloudStatus('syncing', 'Controllo cloud...');
      try {
        const { data, error } = await sb
          .from('study_progress')
          .select('*')
          .eq('course_id', courseId)
          .maybeSingle();

        if (error) {
          console.warn('Errore lettura Supabase:', error);
          setCloudStatus('error', 'Errore cloud (tabella?)');
          return;
        }

        if (data && data.completed_lessons) {
          localStorage.setItem(getStorageKey(), JSON.stringify(data.completed_lessons));
          if (data.target_date) {
            localStorage.setItem(getTargetDateKey(), data.target_date);
          }
          renderLessons();
          updateStats();
          loadTargetDate();
          calculatePace();
          setCloudStatus('synced', 'Cloud sincronizzato');
        } else {
          const localStored = localStorage.getItem(getStorageKey());
          let completedList = localStored ? JSON.parse(localStored) : null;
          let targetVal = localStorage.getItem(getTargetDateKey()) || '';

          if (!completedList && DEFAULT_PRELOADS[courseId]) {
            completedList = DEFAULT_PRELOADS[courseId].completed;
            targetVal = DEFAULT_PRELOADS[courseId].targetDate;
            localStorage.setItem(getStorageKey(), JSON.stringify(completedList));
            if (targetVal) localStorage.setItem(getTargetDateKey(), targetVal);
            renderLessons();
            updateStats();
            loadTargetDate();
            calculatePace();
          }

          if (completedList) {
            await syncToCloud(courseId, completedList, targetVal);
          } else {
            setCloudStatus('synced', 'Cloud pronto');
          }
        }
      } catch (e) {
        console.error('Eccezione syncFromCloud:', e);
        setCloudStatus('error', 'Errore connessione');
      }
    }

    async function syncToCloud(courseId, completedList, targetDate) {
      const sb = getSupabaseClient();
      if (!sb) {
        setCloudStatus('error', 'Offline');
        return;
      }
      setCloudStatus('syncing', 'Salvataggio...');
      try {
        const payload = {
          course_id: courseId,
          completed_lessons: completedList !== undefined ? completedList : [...getCompletedSet()],
          target_date: targetDate !== undefined ? targetDate : (localStorage.getItem(getTargetDateKey()) || ''),
          updated_at: new Date().toISOString()
        };
        const { error } = await sb
          .from('study_progress')
          .upsert(payload, { onConflict: 'course_id' });

        if (error) {
          console.warn('Errore salvataggio Supabase:', error);
          setCloudStatus('error', 'Errore salvataggio');
        } else {
          setCloudStatus('synced', 'Cloud sincronizzato');
        }
      } catch (e) {
        console.error('Eccezione syncToCloud:', e);
        setCloudStatus('error', 'Errore sync');
      }
    }

    function queueCloudSave() {
      clearTimeout(saveTimeout);
      setCloudStatus('syncing', 'In attesa...');
      saveTimeout = setTimeout(() => {
        syncToCloud(currentCourseId);
      }, 500);
    }

    function switchCourse(courseId) {
      if (!COURSES_DATA[courseId]) return;
      currentCourseId = courseId;
      localStorage.setItem('polimi_selected_course_v1', courseId);
      currentFilter = 'all';

      document.querySelectorAll('.course-btn').forEach(btn => {
        if (btn.getAttribute('data-course') === courseId) {
          btn.classList.add('active');
        } else {
          btn.classList.remove('active');
        }
      });

      renderCourseHeader();
      renderFilterTabs();
      loadTargetDate();
      renderLessons();
      updateStats();
      calculatePace();
      syncFromCloud(courseId);
    }

    function renderCourseHeader() {
      const c = COURSES_DATA[currentCourseId];
      document.getElementById('courseBadge').textContent = c.badge;
      document.getElementById('courseTitle').textContent = c.name;
      document.getElementById('courseDesc').textContent = c.description;
    }

    function renderFilterTabs() {
      const c = COURSES_DATA[currentCourseId];
      const container = document.getElementById('filterTabsContainer');
      
      let html = `<button class="tab-btn active" onclick="setFilter('all', this)">Tutte (${c.lessons.length})</button>`;
      
      c.modules.forEach(m => {
        const count = c.lessons.filter(l => l.module === m).length;
        html += `<button class="tab-btn" onclick="setFilter('${m}', this)">${m} (${count})</button>`;
      });

      html += `
        <button class="tab-btn" onclick="setFilter('todo', this)">Da Fare</button>
        <button class="tab-btn" onclick="setFilter('done', this)">Completate</button>
      `;

      container.innerHTML = html;
    }

    function loadTargetDate() {
      const savedDate = localStorage.getItem(getTargetDateKey());
      const dateInput = document.getElementById('targetDate');
      if (savedDate) {
        dateInput.value = savedDate;
      } else {
        const d = new Date();
        d.setDate(d.getDate() + 14);
        dateInput.value = d.toISOString().split('T')[0];
      }
    }

    function toggleLesson(id) {
      const completedSet = getCompletedSet();
      if (completedSet.has(id)) {
        completedSet.delete(id);
      } else {
        completedSet.add(id);
      }
      localStorage.setItem(getStorageKey(), JSON.stringify([...completedSet]));
      renderLessons();
      updateStats();
      calculatePace();
      queueCloudSave();
    }

    function updateStats() {
      const c = COURSES_DATA[currentCourseId];
      const completedSet = getCompletedSet();
      const totalSec = c.lessons.reduce((acc, cur) => acc + cur.duration_sec, 0);
      const doneSec = c.lessons.filter(l => completedSet.has(l.id)).reduce((acc, cur) => acc + cur.duration_sec, 0);
      const remSec = Math.max(0, totalSec - doneSec);

      const remH = (remSec / 3600).toFixed(1);
      const doneH = (doneSec / 3600).toFixed(1);
      const totalH = (totalSec / 3600).toFixed(1);

      const doneCount = completedSet.size;
      const pct = Math.round((doneSec / totalSec) * 100);

      document.getElementById('remainingHours').innerHTML = `${remH} <span class="unit">ore</span>`;
      document.getElementById('remainingSub').textContent = `su ${totalH}h totali (${formatHoursAndMins(remSec)} rimanenti)`;
      
      document.getElementById('completedCount').innerHTML = `${doneCount} <span class="unit">/ ${c.lessons.length}</span>`;
      document.getElementById('completedPct').textContent = `${pct}% del corso completato`;

      document.getElementById('progressFill').style.width = `${pct}%`;
      document.getElementById('progressLabel').textContent = `${pct}% (${doneH}h / ${totalH}h)`;
    }

    function calculatePace() {
      const dateInput = document.getElementById('targetDate');
      const targetVal = dateInput.value;
      if (!targetVal) {
        document.getElementById('paceVal').textContent = '-- h/giorno';
        document.getElementById('paceSub').textContent = 'Seleziona una data per il calcolo';
        return;
      }

      if (localStorage.getItem(getTargetDateKey()) !== targetVal) {
        localStorage.setItem(getTargetDateKey(), targetVal);
        queueCloudSave();
      }

      const now = new Date();
      now.setHours(0, 0, 0, 0);
      const target = new Date(targetVal);
      target.setHours(0, 0, 0, 0);

      const diffTime = target - now;
      const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));

      const c = COURSES_DATA[currentCourseId];
      const completedSet = getCompletedSet();
      const totalSec = c.lessons.reduce((acc, cur) => acc + cur.duration_sec, 0);
      const doneSec = c.lessons.filter(l => completedSet.has(l.id)).reduce((acc, cur) => acc + cur.duration_sec, 0);
      const remSec = Math.max(0, totalSec - doneSec);
      const remH = remSec / 3600;

      if (diffDays <= 0) {
        if (remSec === 0) {
          document.getElementById('paceVal').textContent = 'Finito! 🎉';
          document.getElementById('paceSub').textContent = 'Tutte le lezioni completate!';
        } else {
          document.getElementById('paceVal').textContent = `${remH.toFixed(1)} h oggi`;
          document.getElementById('paceSub').textContent = 'La scadenza è oggi o passata!';
        }
        return;
      }

      if (remSec === 0) {
        document.getElementById('paceVal').textContent = '0.0 h/giorno';
        document.getElementById('paceSub').textContent = 'Ottimo lavoro! Corso completato al 100%';
        return;
      }

      const hoursPerDay = (remH / diffDays).toFixed(1);
      const minsPerDay = Math.round((remH / diffDays) * 60);

      document.getElementById('paceVal').textContent = `${hoursPerDay} h/giorno`;
      document.getElementById('paceSub').textContent = `equivalenti a ~${minsPerDay} min/giorno su ${diffDays} giorni rimasti`;
    }

    function formatHoursAndMins(sec) {
      const h = Math.floor(sec / 3600);
      const m = Math.floor((sec % 3600) / 60);
      return `${h}h ${m}m`;
    }

    function setFilter(filter, el) {
      currentFilter = filter;
      document.querySelectorAll('#filterTabsContainer .tab-btn').forEach(b => b.classList.remove('active'));
      if (el) el.classList.add('active');
      renderLessons();
    }

    function renderLessons() {
      const c = COURSES_DATA[currentCourseId];
      const completedSet = getCompletedSet();
      const container = document.getElementById('lessonsContainer');

      let filtered = c.lessons.filter(l => {
        const isDone = completedSet.has(l.id);
        if (currentFilter === 'todo') return !isDone;
        if (currentFilter === 'done') return isDone;
        if (currentFilter !== 'all') return l.module === currentFilter;
        return true;
      });

      document.getElementById('filterCountLabel').textContent = `Mostrando ${filtered.length} di ${c.lessons.length} lezioni`;

      if (filtered.length === 0) {
        container.innerHTML = `
          <div style="text-align: center; padding: 3rem; color: var(--text-dim); background: var(--card-bg); border-radius: 1rem; border: 1px dashed var(--card-border);">
            Nessuna lezione trovata con il filtro selezionato.
          </div>
        `;
        return;
      }

      container.innerHTML = filtered.map(l => {
        const isDone = completedSet.has(l.id);
        const moduleClass = l.module.toLowerCase().replace(/[^a-z0-9]/g, '-');

        return `
          <div class="lesson-item ${isDone ? 'completed' : ''}" onclick="toggleLesson('${l.id}')">
            <div class="checkbox-wrap" onclick="event.stopPropagation(); toggleLesson('${l.id}')">
              <div class="custom-checkbox">
                <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
              </div>
            </div>
            
            <div class="lesson-order">#${String(l.order).padStart(2, '0')}</div>
            <div class="module-pill ${moduleClass}">${l.module} • ${l.code}</div>
            
            <div class="lesson-info">
              <div class="lesson-title">${l.topic}</div>
              <div class="lesson-meta">
                <span class="lesson-duration">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                  ${l.duration_formatted}
                </span>
                <span style="color: var(--text-dim);">${l.name}</span>
              </div>
            </div>
          </div>
        `;
      }).join('');
    }

    function exportState() {
      const data = {
        course: currentCourseId,
        completed: [...getCompletedSet()],
        targetDate: localStorage.getItem(getTargetDateKey()) || '',
        exportedAt: new Date().toISOString()
      };
      const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `${currentCourseId.toLowerCase()}_study_progress.json`;
      a.click();
      URL.revokeObjectURL(url);
    }

    function handleImportFile(event) {
      const file = event.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = async (e) => {
        try {
          const data = JSON.parse(e.target.result);
          if (data && Array.isArray(data.completed)) {
            const course = data.course || currentCourseId;
            if (course !== currentCourseId && COURSES_DATA[course]) {
              currentCourseId = course;
            }
            localStorage.setItem(getStorageKey(), JSON.stringify(data.completed));
            if (data.targetDate) {
              localStorage.setItem(getTargetDateKey(), data.targetDate);
            }
            renderLessons();
            updateStats();
            loadTargetDate();
            calculatePace();
            await syncToCloud(currentCourseId, data.completed, data.targetDate || '');
            alert('Progressi importati e sincronizzati su Supabase con successo!');
          } else {
            alert('Formato file JSON non valido.');
          }
        } catch (err) {
          alert('Errore lettura JSON: ' + err.message);
        }
      };
      reader.readAsText(file);
      event.target.value = '';
    }

    async function resetState() {
      if (confirm(`Sei sicuro di voler resettare i progressi per il corso ${COURSES_DATA[currentCourseId].name}?`)) {
        localStorage.removeItem(getStorageKey());
        renderLessons();
        updateStats();
        calculatePace();
        await syncToCloud(currentCourseId, [], localStorage.getItem(getTargetDateKey()) || '');
      }
    }

    window.switchCourse = switchCourse;
    window.toggleLesson = toggleLesson;
    window.setFilter = setFilter;
    window.calculatePace = calculatePace;
    window.exportState = exportState;
    window.resetState = resetState;
    window.handleImportFile = handleImportFile;

    // Inizializza subito le lezioni
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => switchCourse(currentCourseId));
    } else {
      switchCourse(currentCourseId);
    }

  </script>
</body>
</html>